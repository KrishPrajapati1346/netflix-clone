# =============================================================================
# Kinora — environment template
# =============================================================================
# Copy to `.env` in the repository root:  cp .env.example .env
#
# Every value below is OPTIONAL in development. With an empty file the API still
# boots: it connects to a local MongoDB, generates throwaway JWT secrets, logs
# verification links instead of emailing them, and hides the social sign-in
# buttons. Fill a section in to switch that integration on.
#
# In PRODUCTION the marked values are required and the server refuses to start
# without them, rather than booting half-configured.
# =============================================================================

NODE_ENV=development
PORT=4000

# --- Database ---------------------------------------------------------------
# Local:  mongodb://127.0.0.1:27017/kinora
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kinora
# REQUIRED in production.
MONGODB_URI=mongodb://127.0.0.1:27017/kinora
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/kinora_test

# --- Secrets ----------------------------------------------------------------
# REQUIRED in production, and they must differ from each other.
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- URLs -------------------------------------------------------------------
# CLIENT_URL is both the CORS allow-list entry and the base for emailed links.
# REQUIRED in production.
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:4000
# Comma-separated extra origins, e.g. Vercel preview deployments.
CORS_EXTRA_ORIGINS=

# --- Cookies ----------------------------------------------------------------
# Set CROSS_SITE_COOKIES=true when the client and API are on different sites
# (e.g. Vercel + Render). That switches the refresh cookie to SameSite=None,
# which also forces Secure. Leave false for same-origin or local development.
CROSS_SITE_COOKIES=false
COOKIE_DOMAIN=

# --- Email (optional) -------------------------------------------------------
# Without these, verification and reset links are written to the server log and
# returned in API responses (development only — never in production).
# Free options: Mailtrap, Brevo, or Gmail with an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Kinora <no-reply@kinora.local>

# --- OAuth (optional) -------------------------------------------------------
# Each provider's button is hidden until its pair is filled in.
# Google  → https://console.cloud.google.com/apis/credentials
#   Authorised redirect URI: http://localhost:4000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub  → https://github.com/settings/developers
#   Authorisation callback URL: http://localhost:4000/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Cloudinary (optional) --------------------------------------------------
# Avatar and artwork uploads. Without it, uploads fall back to local disk
# storage under server/uploads/ and the bundled avatar set still works.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- TMDB (optional) --------------------------------------------------------
# Only needed for `npm run seed:tmdb`, which ingests real catalog metadata.
# `npm run seed` works without it, using the committed fixtures.
# Key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- Atlas Search (optional) ------------------------------------------------
# Set true ONLY on an Atlas cluster where the `titles_search` index exists.
# On community/local MongoDB leave this false: search falls back to a regular
# text index, which works but without fuzzy matching or autocomplete.
ATLAS_SEARCH_ENABLED=false

# --- Logging ----------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Seed admin (optional) --------------------------------------------------
# When set, `npm run seed` creates this admin account. Without it the seed
# prints generated credentials instead.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
